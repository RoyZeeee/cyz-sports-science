---
import ExerciseVisual from "./ExerciseVisual.astro";
import Rating from "./Rating.astro";
import type { Lang } from "../data/content";
import type { Exercise } from "../data/tools";
import { difficultyLabel, listText, subMuscleLabels, text, toolCopy } from "../data/tools";
import { href } from "../utils/paths";

const { exercise, lang } = Astro.props as { exercise: Exercise; lang: Lang };
const copy = toolCopy(lang);
const subLabels = subMuscleLabels(exercise.subMuscles, lang);
const searchText = [
  exercise.slug,
  text(exercise.name, lang),
  exercise.name.zh,
  exercise.name.en,
  text(exercise.summary, lang),
  ...listText(exercise.primary, lang),
  ...listText(exercise.secondary, lang),
  ...subLabels,
  text(exercise.equipment, lang),
].join(" ");
---

<a
  class="card exercise-card"
  href={href(`/${lang}/exercises/${exercise.slug}/`)}
  data-exercise-card
  data-muscle={exercise.muscleGroup}
  data-submuscles={(exercise.subMuscles ?? []).join(" ")}
  data-difficulty={exercise.difficulty}
  data-rating={exercise.rating}
  data-equipment={text(exercise.equipment, lang)}
  data-search={searchText.toLowerCase()}
>
  <ExerciseVisual exercise={exercise} lang={lang} compact />
  <div class="exercise-card-body">
    <h3>{text(exercise.name, lang)}</h3>
    <p>{text(exercise.summary, lang)}</p>
    <div class="meta-row">
      <Rating value={exercise.rating} label={copy.rating} />
      <span class="tag">{difficultyLabel(exercise.difficulty, lang)}</span>
    </div>
    {subLabels.length > 0 && <div class="tag-row mini-tags">{subLabels.map((label) => <span class="tag strong-tag">{label}</span>)}</div>}
    <p class="mini-meta">{copy.primary}: {listText(exercise.primary, lang).join("、")}</p>
  </div>
  <span class="pill-link">{copy.read}</span>
</a>
