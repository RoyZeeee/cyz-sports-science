---
import type { Exercise } from "../data/tools";
import { text } from "../data/tools";
import type { Lang } from "../data/content";

const { exercise, lang, compact = false } = Astro.props as { exercise: Exercise; lang: Lang; compact?: boolean };
const focus = exercise.visualFocus;
const active = (part: Exercise["visualFocus"] | "legs") =>
  focus === part || (part === "legs" && (focus === "quads" || focus === "hamstrings" || focus === "calves"));
const posterior = focus === "back" || focus === "glutes" || focus === "hamstrings" || focus === "calves";
---

<figure class:list={["exercise-visual", compact && "compact"]} aria-label={text(exercise.name, lang)}>
  <svg viewBox="0 0 320 230" role="img">
    <rect class="visual-bg" x="0" y="0" width="320" height="230" rx="8"></rect>
    <text class="view-label" x="82" y="22">{lang === "en" ? "Front" : "前側"}</text>
    <text class="view-label" x="226" y="22">{lang === "en" ? "Back" : "後側"}</text>

    <g class:list={["anatomy-view", !posterior && "preferred"]} transform="translate(26 26)">
      <circle class="body-part neutral" cx="62" cy="16" r="12"></circle>
      <path class="body-outline" d="M49 31h26l13 21 21 8 10 43-15 3-10-31-8 39 10 76h-21l-13-58-13 58h-21l10-76-8-39-10 31-15-3 10-43 21-8z"></path>
      <path class:list={["muscle", "deltoid", active("shoulders") && "active"]} d="M35 46c10-14 21-15 30-5l-12 21c-9 0-16-5-18-16z"></path>
      <path class:list={["muscle", "deltoid", active("shoulders") && "active"]} d="M89 46c-10-14-21-15-30-5l12 21c9 0 16-5 18-16z"></path>
      <path class:list={["muscle", active("chest") && "active"]} d="M43 53c10-8 24-9 33 0-4 14-12 21-28 22z"></path>
      <path class:list={["muscle", active("chest") && "active"]} d="M81 53c-10-8-24-9-33 0 4 14 12 21 28 22z"></path>
      <path class:list={["muscle", active("core") && "active"]} d="M49 77h26l5 40-18 8-18-8z"></path>
      <path class="separation" d="M62 78v44M51 91h22M50 105h24"></path>
      <path class:list={["muscle", active("arms") && "active"]} d="M23 68c-10 17-13 36-12 57h15c1-19 5-35 14-48z"></path>
      <path class:list={["muscle", active("arms") && "active"]} d="M101 68c10 17 13 36 12 57h-15c-1-19-5-35-14-48z"></path>
      <path class:list={["muscle", active("quads") && "active"]} d="M39 122h21l-8 67h-22z"></path>
      <path class:list={["muscle", active("quads") && "active"]} d="M64 122h21l9 67h-22z"></path>
      <path class:list={["muscle", active("calves") && "active"]} d="M29 184h23l-5 24h-22z"></path>
      <path class:list={["muscle", active("calves") && "active"]} d="M72 184h23l5 24h-22z"></path>
    </g>

    <g class:list={["anatomy-view", posterior && "preferred"]} transform="translate(170 26)">
      <circle class="body-part neutral" cx="62" cy="16" r="12"></circle>
      <path class="body-outline" d="M49 31h26l13 21 21 8 10 43-15 3-10-31-8 39 10 76h-21l-13-58-13 58h-21l10-76-8-39-10 31-15-3 10-43 21-8z"></path>
      <path class:list={["muscle", active("back") && "active"]} d="M49 34h26l13 34-26 31-26-31z"></path>
      <path class:list={["muscle", active("back") && "active"]} d="M38 62c-18 14-25 32-26 55h17c4-19 12-34 25-45z"></path>
      <path class:list={["muscle", active("back") && "active"]} d="M86 62c18 14 25 32 26 55h-17c-4-19-12-34-25-45z"></path>
      <path class:list={["muscle", active("shoulders") && "active"]} d="M35 44c10-11 20-12 29-4l-13 22c-8-1-14-7-16-18z"></path>
      <path class:list={["muscle", active("shoulders") && "active"]} d="M89 44c-10-11-20-12-29-4l13 22c8-1 14-7 16-18z"></path>
      <path class:list={["muscle", active("arms") && "active"]} d="M23 68c-10 17-13 36-12 57h15c1-19 5-35 14-48z"></path>
      <path class:list={["muscle", active("arms") && "active"]} d="M101 68c10 17 13 36 12 57h-15c-1-19-5-35-14-48z"></path>
      <path class:list={["muscle", active("glutes") && "active"]} d="M38 116c10-10 19-9 24 3-4 17-14 25-27 22z"></path>
      <path class:list={["muscle", active("glutes") && "active"]} d="M86 116c-10-10-19-9-24 3 4 17 14 25 27 22z"></path>
      <path class:list={["muscle", active("hamstrings") && "active"]} d="M38 139h22l-7 50h-23z"></path>
      <path class:list={["muscle", active("hamstrings") && "active"]} d="M64 139h22l8 50h-23z"></path>
      <path class:list={["muscle", active("calves") && "active"]} d="M29 184h23l-5 24h-22z"></path>
      <path class:list={["muscle", active("calves") && "active"]} d="M72 184h23l5 24h-22z"></path>
      <path class="separation" d="M62 35v78M42 78h40M62 119v23"></path>
    </g>
  </svg>
  <figcaption>
    <strong>{text(exercise.name, lang)}</strong>
    <span>{text(exercise.summary, lang)}</span>
  </figcaption>
</figure>
