---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import type { Exercise } from "../data/tools";
import { listText, subMuscleLabels, text } from "../data/tools";
import type { Lang } from "../data/content";
import { href } from "../utils/paths";

const { exercise, lang, compact = false } = Astro.props as { exercise: Exercise; lang: Lang; compact?: boolean };
const anatomySvg = readFileSync(fileURLToPath(new URL("../../public/images/muscles-front-back.svg", import.meta.url)), "utf-8");
const primarySlugs = exercise.subMuscles ?? [];
const secondaryText = [...exercise.secondary.flatMap((item) => [item.zh, item.en]), text(exercise.summary, lang)].join(" ").toLowerCase();
const secondarySet = new Set<string>();
const addIf = (slug: string, pattern: RegExp) => {
  if (pattern.test(secondaryText)) secondarySet.add(slug);
};

addIf("front-delts", /前三角|front delt|shoulder|肩/);
addIf("side-delts", /中三角|side delt|lateral/);
addIf("rear-delts", /後三角|rear delt|後束/);
addIf("rotator-cuff", /旋轉|rotator/);
addIf("triceps", /三頭|triceps/);
addIf("biceps", /二頭|biceps|肱肌|brachialis/);
addIf("forearms", /前臂|forearm|grip|握力|wrist/);
addIf("upper-back", /上背|upper back|trap|斜方|rhomboid|菱形|下斜方|中下斜方/);
addIf("mid-back", /中背|mid back/);
addIf("lats", /背闊|lat|lats/);
addIf("lower-back", /豎脊|spinal|lower back|下背/);
addIf("quads", /股四|quad|膝/);
addIf("hamstrings", /腿後|hamstring/);
addIf("glute-max", /臀大|glute|臀部|glutes/);
addIf("glute-med", /臀中|abduction|外展/);
addIf("adductors", /內收|adductor/);
addIf("calves", /小腿|calf|腓腸|比目魚/);
addIf("abs", /腹直|abs|core|核心|髖屈/);
addIf("obliques", /腹斜|oblique/);

const primaryLabels = subMuscleLabels(primarySlugs, lang);
const assistantLabels = listText(exercise.secondary, lang);
const compactPrimaryLabel = primaryLabels.join(" / ") || listText(exercise.primary, lang).join(" / ");
const copy = {
  front: lang === "en" ? "Front" : lang === "zh-cn" ? "前侧" : "前側",
  back: lang === "en" ? "Back" : lang === "zh-cn" ? "后侧" : "後側",
  main: lang === "en" ? "Main" : lang === "zh-cn" ? "主练" : "主練",
  assist: lang === "en" ? "Assist" : lang === "zh-cn" ? "辅助" : "輔助",
  target: lang === "en" ? "Muscle map" : lang === "zh-cn" ? "肌肉图" : "肌肉圖",
};

const anatomyPathMap: Record<string, string[]> = {
  "upper-chest": ["path861"],
  "mid-chest": ["path847"],
  "lower-chest": ["path847"],
  lats: ["path2085", "path2115", "path2163", "path2024"],
  "upper-back": ["path1268", "path1919", "path1432"],
  "mid-back": ["path1268", "path1919"],
  "lower-back": ["path1919"],
  "rear-delts": ["path1452", "path1432"],
  "front-delts": [],
  "side-delts": [],
  "rotator-cuff": ["path2085", "path2115", "path2163"],
  quads: ["path1554", "path1366"],
  hamstrings: ["path2990", "path2900", "path2931", "path2803"],
  "glute-max": ["path2744", "path2220"],
  "glute-med": ["path2744"],
  adductors: ["path1337"],
  calves: ["path3254", "path3216", "path3075", "path3022"],
  biceps: ["path908", "path968", "path881"],
  triceps: ["path1109", "path1513", "path1486", "path1542"],
  forearms: ["path1065", "path1080", "path998", "path987", "path991"],
  abs: ["path1100"],
  obliques: ["path1100"],
};

const titleId = `semantic-visual-title-${exercise.slug}`;
const anatomyTitle = `${text(exercise.name, lang)} - ${primaryLabels.join(" / ")}`;
const compactAnatomySlug = primarySlugs.find((slug) => anatomyPathMap[slug]?.length) ?? "";
const compactAnatomySrc = compactAnatomySlug ? href(`/images/anatomy-targets/${compactAnatomySlug}.svg`) : href("/images/muscles-front-back.svg");
const findSvgElementById = (svg: string, id: string) => {
  const startTag = new RegExp(`<(?<tag>path|rect|use|g)\\b[^>]*\\bid="${id}"[^>]*>`, "m").exec(svg);
  const selfClosing = new RegExp(`<(?<tag>path|rect|use)\\b[^>]*\\bid="${id}"[^>]*/>`, "m").exec(svg);
  if (selfClosing) return selfClosing[0];
  if (!startTag?.groups?.tag) return "";
  const tag = startTag.groups.tag;
  const start = startTag.index;
  if (tag !== "g") {
    const end = svg.indexOf(`</${tag}>`, start);
    return end === -1 ? "" : svg.slice(start, end + tag.length + 3);
  }

  let depth = 0;
  const tagPattern = /<\/?g\b[^>]*>/g;
  tagPattern.lastIndex = start;
  for (const match of svg.matchAll(tagPattern)) {
    if (match.index < start) continue;
    depth += match[0].startsWith("</") ? -1 : 1;
    if (depth === 0) return svg.slice(start, match.index + match[0].length);
  }
  return "";
};

const mirrorReferenceMap = new Map<string, string[]>();
for (const match of anatomySvg.matchAll(/<use\b[\s\S]*?\/>/g)) {
  const tag = match[0];
  const useId = tag.match(/\bid="([^"]+)"/)?.[1];
  const href = tag.match(/\b(?:xlink:href|href)="#([^"]+)"/)?.[1];
  if (!useId || !href) continue;
  const referenced = findSvgElementById(anatomySvg, href);
  const referencedIds = [...referenced.matchAll(/\bid="([^"]+)"/g)].map((idMatch) => idMatch[1]);
  for (const referencedId of referencedIds) {
    mirrorReferenceMap.set(referencedId, [...(mirrorReferenceMap.get(referencedId) ?? []), `${referencedId}__${useId}`]);
  }
}

const withMirrors = (ids: string[]) => [...new Set(ids.flatMap((id) => [id, ...(mirrorReferenceMap.get(id) ?? [])]))];

const primaryPathIds = withMirrors(primarySlugs.flatMap((slug) => anatomyPathMap[slug] ?? []));
const secondaryPathIds = withMirrors([...secondarySet].flatMap((slug) => anatomyPathMap[slug] ?? [])).filter((id) => !primaryPathIds.includes(id));

const expandUseElements = (svg: string) =>
  svg.replace(/<use\b[\s\S]*?\/>/g, (tag) => {
    const useId = tag.match(/\bid="([^"]+)"/)?.[1];
    const href = tag.match(/\b(?:xlink:href|href)="#([^"]+)"/)?.[1];
    if (!useId || !href) return tag;
    const referenced = findSvgElementById(svg, href);
    if (!referenced) return tag;
    const transform = tag.match(/\btransform="([^"]+)"/)?.[1];
    const cloneIds = new Set([...referenced.matchAll(/\bid="([^"]+)"/g)].map((idMatch) => idMatch[1]));
    const cloned = referenced
      .replace(/\s+x="[^"]*"/g, "")
      .replace(/\s+y="[^"]*"/g, "")
      .replace(/\s+width="[^"]*"/g, "")
      .replace(/\s+height="[^"]*"/g, "")
      .replace(/\bid="([^"]+)"/g, (_match, id) => `id="${id}__${useId}"`)
      .replace(/\b(xlink:href|href)="#([^"]+)"/g, (match, attr, id) => (cloneIds.has(id) ? `${attr}="#${id}__${useId}"` : match));
    return transform ? `<g transform="${transform}">${cloned}</g>` : `<g>${cloned}</g>`;
  });

const semanticAnatomySvg = (mode: "detail" | "compact") => {
  const scopeClass = `muscle-scope-${exercise.slug}-${mode}`;
  const scopedSelector = (ids: string[]) => ids.map((id) => `.${scopeClass} #${id}`).join(", ");
  const primarySelector = scopedSelector(primaryPathIds);
  const secondarySelector = scopedSelector(secondaryPathIds);
  const svgClass = mode === "compact" ? `semantic-anatomy-svg compact-anatomy-svg ${scopeClass}` : `semantic-anatomy-svg ${scopeClass}`;
  const useSecondary = mode === "detail";
  const title = `${titleId}-${mode}`;
  const anatomyStyles = `
  <style><![CDATA[
    .semantic-anatomy-svg {
      background: #fbf7ef;
    }
    .semantic-anatomy-svg path,
    .semantic-anatomy-svg use,
    .semantic-anatomy-svg rect {
      transition: fill .16s ease, stroke .16s ease, opacity .16s ease;
    }
    ${useSecondary && secondarySelector ? `${secondarySelector} {
      fill: #e4a178 !important;
      fill-opacity: 1 !important;
      stroke: #985431 !important;
      stroke-width: .85 !important;
      opacity: 1 !important;
    }` : ""}
    ${primarySelector ? `${primarySelector} {
      fill: #137d78 !important;
      fill-opacity: 1 !important;
      stroke: #053c3a !important;
      stroke-width: 1.05 !important;
      opacity: 1 !important;
    }` : ""}
  ]]></style>
`;
  return expandUseElements(anatomySvg)
    .replace(/<\?xml[^>]*>\s*/i, "")
    .replace(
      /<svg\b([^>]*)>/,
      `<svg$1 class="${svgClass}" role="img" aria-labelledby="${title}">${anatomyStyles}<title id="${title}">${anatomyTitle}</title>`,
    );
};
---

<figure class:list={["exercise-visual", "anatomy-card", compact && "compact"]} aria-label={`${text(exercise.name, lang)} ${copy.target}`}>
  {
    compact ? (
      <img class="compact-anatomy-img" src={compactAnatomySrc} alt={anatomyTitle} loading="lazy" />
    ) : (
      <Fragment set:html={semanticAnatomySvg("detail")} />
    )
  }
  {
    compact && (
      <div class="compact-muscle-labels">
        <span class="compact-label primary-label">{copy.main}: {compactPrimaryLabel}</span>
      </div>
    )
  }
  {
    !compact && (
      <div class="visual-key" aria-label={copy.target}>
        <span><i class="legend-dot primary"></i>{copy.main}: {primaryLabels.join(" / ") || listText(exercise.primary, lang).join(" / ")}</span>
        <span><i class="legend-dot secondary"></i>{copy.assist}: {assistantLabels.join(" / ") || "-"}</span>
        <span class="visual-source">OpenStax / Wikimedia CC BY-SA 4.0</span>
      </div>
    )
  }
  <figcaption>
    <strong>{text(exercise.name, lang)}</strong>
    <span>{text(exercise.summary, lang)}</span>
  </figcaption>
</figure>
