---
import type { Lang } from "../data/content";
import { href as withBase } from "../utils/paths";

type Props = {
  lang: Lang;
  alternatePath?: string;
};

const { lang } = Astro.props;
const languageOptions: { lang: Lang; label: string }[] = [
  { lang: "zh", label: "繁中" },
  { lang: "zh-cn", label: "简中" },
  { lang: "en", label: "English" },
];

function localizedPath(targetLang: Lang) {
  return withBase(`/${targetLang}/`);
}
---

<span class="language-switcher">
  {
    languageOptions.map((option) => (
      <a href={localizedPath(option.lang)} aria-label={`Switch language to ${option.label}`} aria-current={option.lang === lang ? "page" : undefined}>
        {option.label}
      </a>
    ))
  }
</span>
