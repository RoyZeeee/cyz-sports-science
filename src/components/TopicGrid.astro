---
import { topicDescription, topics, topicTitle, type Lang } from "../data/content";
import { href } from "../utils/paths";

const { lang } = Astro.props as { lang: Lang };
const browseLabel = lang === "zh" ? "瀏覽主題" : lang === "zh-cn" ? "浏览主题" : "Browse topic";
---

<div class="grid">
  {
    topics.map((topic) => (
      <a class="card topic-card" data-accent={topic.accent} href={href(`/${lang}/topics/${topic.slug}/`)}>
        <div>
          <h3>{topicTitle(topic, lang)}</h3>
          <p>{topicDescription(topic, lang)}</p>
        </div>
        <span class="pill-link">{browseLabel}</span>
      </a>
    ))
  }
</div>
