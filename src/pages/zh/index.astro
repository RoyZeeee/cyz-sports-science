---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import QuestionForm from "../../components/QuestionForm.astro";
import TopicGrid from "../../components/TopicGrid.astro";
import { articles, byLang, faqs } from "../../data/content";
import { searchGuides, guideText } from "../../data/searchGuides";
import { exercises } from "../../data/tools";
import { href } from "../../utils/paths";

const lang = "zh";
const featuredFaqs = byLang(faqs, lang).slice(0, 5);
const featuredArticles = byLang(articles, lang).slice(0, 3);
const featuredGuides = searchGuides.slice(0, 3);
---

<BaseLayout
  lang={lang}
  title="超越者運動科學"
  description="用證據回答增肌、減脂、補劑、恢復與中老年訓練問題。"
  path="/zh/"
  alternatePath="/en/"
>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">健身問題，先問證據</p>
      <h1>把常見健身疑問，整理成能實際使用的科學答案。</h1>
      <p class="lede">
        從蛋白粉、肌酸、有氧、減脂到中老年重訓，這裡把熱門問題和研究證據放在同一張地圖上。
      </p>
      <div class="tag-row">
        <span class="tag">增肌</span>
        <span class="tag">減脂</span>
        <span class="tag">補劑避坑</span>
        <span class="tag">恢復</span>
      </div>
    </div>
    <aside class="hero-panel" aria-label="熱門問題">
      <h2>熱門問題</h2>
      <div class="question-strip">
        {featuredFaqs.map((faq) => <a href={href(`/zh/faq/${faq.slug}/`)}><strong>{faq.title}</strong><span>{faq.description}</span></a>)}
      </div>
    </aside>
  </section>
  <section class="container section">
    <AdSlot variant="banner" label="Content ad" />
    <div class="section-head">
      <div>
        <h2>從目標開始找答案</h2>
        <p>不是每個人都需要同一套補劑、課表或飲食策略。先選情境，再看證據。</p>
      </div>
      <a class="pill-link" href={href("/zh/topics/")}>全部主題</a>
    </div>
    <TopicGrid lang={lang} />
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>完整指南</h2>
        <p>把搜尋者真正會問的問題整理成主題入口，再連到 FAQ、動作庫、食物庫和證據。</p>
      </div>
      <a class="pill-link" href={href("/zh/guides/")}>全部指南</a>
    </div>
    <div class="grid">
      {featuredGuides.map((guide) => (
        <a class="card guide-link-card" href={href(`/zh/guides/${guide.slug}/`)}>
          <div>
            <span class="meta">完整指南</span>
            <h3>{guideText(guide.title, lang)}</h3>
            <p>{guideText(guide.description, lang)}</p>
          </div>
          <span class="pill-link">閱讀指南</span>
        </a>
      ))}
    </div>
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>直接查能用的工具</h2>
        <p>不只看 FAQ，也能從動作、肌群和食物份量開始做決策。</p>
      </div>
    </div>
    <div class="grid">
      <a class="card tool-card" href={href("/zh/exercises/")}>
        <div><span class="meta">{exercises.length} 個動作</span><h3>動作庫</h3><p>圖片、主練肌群、器材、難度和推薦指數一次看。</p></div>
        <span class="pill-link">看動作</span>
      </a>
      <a class="card tool-card" href={href("/zh/muscles/")}>
        <div><span class="meta">7 個肌群</span><h3>想練哪一塊？</h3><p>胸、背、肩、腿、臀、腹、手臂，各自列出推薦動作排名。</p></div>
        <span class="pill-link">選肌群</span>
      </a>
      <a class="card tool-card" href={href("/zh/foods/")}>
        <div><span class="meta">常見份量</span><h3>食物營養庫</h3><p>雞蛋用顆，其餘用常見份量或 100 g 建立熱量和營養直覺。</p></div>
        <span class="pill-link">查食物</span>
      </a>
    </div>
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>精選文章</h2>
        <p>從內部 wiki 精選並改寫，適合做長文、短影音腳本和內容產品素材。</p>
      </div>
      <a class="pill-link" href={href("/zh/articles/")}>全部文章</a>
    </div>
    <div class="grid">
      {featuredArticles.map((article) => (
        <a class="card" href={href(`/zh/articles/${article.slug}/`)}>
          <div>
            <span class="meta">{article.readingTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </div>
          <span class="pill-link">閱讀</span>
        </a>
      ))}
    </div>
  </section>
  <div class="container">
    <QuestionForm lang={lang} />
  </div>
</BaseLayout>
