---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QuestionForm from "../../../components/QuestionForm.astro";
import TopicSeoGuide from "../../../components/TopicSeoGuide.astro";
import { articles, faqs, topics } from "../../../data/content";
import { searchGuides, guideText } from "../../../data/searchGuides";
import { topicGuideBySlug } from "../../../data/topicGuides";
import { href } from "../../../utils/paths";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const guide = topicGuideBySlug(topic.slug);
if (!guide) throw new Error("Topic guide not found");
const topicFaqs = faqs.filter((faq) => faq.lang === "zh" && faq.topic === topic.slug);
const topicArticles = articles.filter((article) => article.lang === "zh" && article.topic === topic.slug);
const topicSearchGuides = searchGuides.filter((item) => item.topic === topic.slug);
---

<BaseLayout lang="zh" title={guide.zhSeoTitle} description={guide.zhDescription} path={`/zh/topics/${topic.slug}/`} alternatePath={`/en/topics/${topic.slug}/`}>
  <section class="container section">
    <p class="eyebrow">完整指南</p>
    <h1>{guide.zhH1}</h1>
    <p class="lede">{guide.zhIntro}</p>
    <TopicSeoGuide guide={guide} lang="zh" />
    <div class="section-head">
      <h2>常見問題</h2>
      <a class="pill-link" href={href("/zh/faq/")}>全部 FAQ</a>
    </div>
    <div class="grid">
      {topicFaqs.slice(0, 6).map((faq) => (
        <a class="card" href={href(`/zh/faq/${faq.slug}/`)}>
          <div><h3>{faq.title}</h3><p>{faq.description}</p></div>
          <span class="pill-link">看回答</span>
        </a>
      ))}
    </div>
    {
      topicArticles.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 34px;">
            <h2>文章</h2>
            <a class="pill-link" href={href("/zh/articles/")}>全部文章</a>
          </div>
          <div class="grid">
            {topicArticles.slice(0, 6).map((article) => (
              <a class="card" href={href(`/zh/articles/${article.slug}/`)}>
                <div><h3>{article.title}</h3><p>{article.description}</p></div>
                <span class="pill-link">閱讀</span>
              </a>
            ))}
          </div>
        </>
      )
    }
    {
      topicSearchGuides.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 34px;">
            <h2>延伸完整指南</h2>
            <a class="pill-link" href={href("/zh/guides/")}>全部指南</a>
          </div>
          <div class="grid">
            {topicSearchGuides.map((item) => (
              <a class="card" href={href(`/zh/guides/${item.slug}/`)}>
                <div><h3>{guideText(item.title, "zh")}</h3><p>{guideText(item.description, "zh")}</p></div>
                <span class="pill-link">閱讀指南</span>
              </a>
            ))}
          </div>
        </>
      )
    }
    <QuestionForm lang="zh" />
  </section>
</BaseLayout>
