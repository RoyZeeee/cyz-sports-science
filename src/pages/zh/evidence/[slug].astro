---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import { evidence } from "../../../data/content";

export function getStaticPaths() {
  return evidence.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout lang="zh" title={item.title} description={item.description} path={`/zh/evidence/${item.slug}/`} alternatePath={`/en/evidence/${item.slug}/`}>
  <div class="container content-layout">
    <article class="article">
      <p class="eyebrow">Evidence · Level {item.strength}</p>
      <h1>{item.title}</h1>
      <p class="lede">{item.description}</p>
      <section>
        <h2>摘要</h2>
        <p>{item.summary}</p>
      </section>
      <section>
        <h2>實務用途</h2>
        <ul>{item.practicalUse.map((use) => <li>{use}</li>)}</ul>
      </section>
      <NewsletterSignup lang="zh" />
    </article>
    <aside class="side-panel">
      <h3>證據等級</h3>
      <p><span class="evidence-badge">{item.strength}</span></p>
      <h3>來源類型</h3>
      <p class="meta">{item.sourceType}</p>
    </aside>
  </div>
</BaseLayout>
