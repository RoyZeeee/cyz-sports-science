---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import { evidenceBySlug, faqs, getTopic } from "../../../data/content";
import { t } from "../../../utils/i18n";
import { href } from "../../../utils/paths";

export function getStaticPaths() {
  return faqs.filter((faq) => faq.lang === "zh").map((faq) => ({ params: { slug: faq.slug }, props: { faq } }));
}

const { faq } = Astro.props;
const topic = getTopic(faq.topic);
const copy = t("zh");
---

<BaseLayout lang="zh" title={faq.title} description={faq.description} path={`/zh/faq/${faq.slug}/`} alternatePath="/en/faq/">
  <div class="container content-layout">
    <article class="article">
      <p class="eyebrow">{topic?.zhTitle} · FAQ</p>
      <h1>{faq.title}</h1>
      <p class="lede">{faq.description}</p>
      {faq.answer.map((paragraph) => <p>{paragraph}</p>)}
      <section>
        <h2>{copy.takeaways}</h2>
        <ul>
          {faq.takeaways.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section>
        <h2>安全邊界</h2>
        <p>{copy.medical}</p>
      </section>
      <NewsletterSignup lang="zh" />
    </article>
    <aside class="side-panel">
      <h3>{copy.audience}</h3>
      <p class="meta">{faq.audience}</p>
      <h3>{copy.evidenceLabel}</h3>
      <p><span class="evidence-badge">{faq.evidence}</span></p>
      <h3>{copy.relatedEvidence}</h3>
      <ul>
        {faq.relatedEvidence.map((slug) => {
          const item = evidenceBySlug(slug);
          return item ? <li><a href={href(`/zh/evidence/${item.slug}/`)}>{item.title}</a></li> : null;
        })}
      </ul>
    </aside>
  </div>
</BaseLayout>
