---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QuestionForm from "../../../components/QuestionForm.astro";
import { articles, byLang, getTopic, topicTitle } from "../../../data/content";
import { href } from "../../../utils/paths";

const lang = "zh-cn";
const items = byLang(articles, lang);
---

<BaseLayout lang={lang} title="文章" description="由运动科学 wiki 改写的公开科普文章。" path="/zh-cn/articles/">
  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Articles</p>
        <h1>科普文章</h1>
        <p>把研究摘要和实务判断转成可以阅读、分享、再拆成内容脚本的文章。</p>
      </div>
    </div>
    <div class="grid">
      {items.map((article) => (
        <a class="card" href={href(`/zh-cn/articles/${article.slug}/`)}>
          <div>
            <div class="tag-row"><span class="tag">{topicTitle(getTopic(article.topic), lang)}</span><span class="tag">{article.readingTime}</span></div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </div>
          <span class="pill-link">阅读</span>
        </a>
      ))}
    </div>
    <QuestionForm lang={lang} />
  </section>
</BaseLayout>
