---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import { localizedEvidence } from "../../../data/content";

export function getStaticPaths() {
  return localizedEvidence("zh-cn").map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const lang = "zh-cn";
---

<BaseLayout lang={lang} title={item.title} description={item.description} path={`/zh-cn/evidence/${item.slug}/`}>
  <div class="container content-layout">
    <article class="article">
      <p class="eyebrow">Evidence · Level {item.strength}</p>
      <h1>{item.title}</h1>
      <p class="lede">{item.description}</p>
      <section>
        <h2>摘要</h2>
        <p>{item.summary}</p>
      </section>
      <section>
        <h2>实务用途</h2>
        <ul>{item.practicalUse.map((use) => <li>{use}</li>)}</ul>
      </section>
      <NewsletterSignup lang={lang} />
    </article>
    <aside class="side-panel">
      <h3>证据等级</h3>
      <p><span class="evidence-badge">{item.strength}</span></p>
      <h3>来源类型</h3>
      <p class="meta">{item.sourceType}</p>
    </aside>
  </div>
</BaseLayout>
