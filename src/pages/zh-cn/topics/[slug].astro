---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QuestionForm from "../../../components/QuestionForm.astro";
import TopicSeoGuide from "../../../components/TopicSeoGuide.astro";
import { articles, byLang, faqs, topics, localizeText } from "../../../data/content";
import { searchGuides, guideText } from "../../../data/searchGuides";
import { topicGuideBySlug } from "../../../data/topicGuides";
import { href } from "../../../utils/paths";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const lang = "zh-cn";
const guide = topicGuideBySlug(topic.slug);
if (!guide) throw new Error("Topic guide not found");
const topicFaqs = byLang(faqs, lang).filter((faq) => faq.topic === topic.slug);
const topicArticles = byLang(articles, lang).filter((article) => article.topic === topic.slug);
const topicSearchGuides = searchGuides.filter((item) => item.topic === topic.slug);
---

<BaseLayout lang={lang} title={localizeText(guide.zhSeoTitle, lang)} description={localizeText(guide.zhDescription, lang)} path={`/zh-cn/topics/${topic.slug}/`}>
  <section class="container section">
    <p class="eyebrow">完整指南</p>
    <h1>{localizeText(guide.zhH1, lang)}</h1>
    <p class="lede">{localizeText(guide.zhIntro, lang)}</p>
    <TopicSeoGuide guide={guide} lang={lang} />
    <div class="section-head">
      <h2>常见问题</h2>
      <a class="pill-link" href={href("/zh-cn/faq/")}>全部 FAQ</a>
    </div>
    <div class="grid">
      {topicFaqs.slice(0, 6).map((faq) => (
        <a class="card" href={href(`/zh-cn/faq/${faq.slug}/`)}>
          <div><h3>{faq.title}</h3><p>{faq.description}</p></div>
          <span class="pill-link">看回答</span>
        </a>
      ))}
    </div>
    {
      topicArticles.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 34px;">
            <h2>文章</h2>
            <a class="pill-link" href={href("/zh-cn/articles/")}>全部文章</a>
          </div>
          <div class="grid">
            {topicArticles.slice(0, 6).map((article) => (
              <a class="card" href={href(`/zh-cn/articles/${article.slug}/`)}>
                <div><h3>{article.title}</h3><p>{article.description}</p></div>
                <span class="pill-link">阅读</span>
              </a>
            ))}
          </div>
        </>
      )
    }
    {
      topicSearchGuides.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 34px;">
            <h2>延伸完整指南</h2>
            <a class="pill-link" href={href("/zh-cn/guides/")}>全部指南</a>
          </div>
          <div class="grid">
            {topicSearchGuides.map((item) => (
              <a class="card" href={href(`/zh-cn/guides/${item.slug}/`)}>
                <div><h3>{guideText(item.title, lang)}</h3><p>{guideText(item.description, lang)}</p></div>
                <span class="pill-link">阅读指南</span>
              </a>
            ))}
          </div>
        </>
      )
    }
    <QuestionForm lang={lang} />
  </section>
</BaseLayout>
