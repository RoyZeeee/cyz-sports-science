---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import QuestionForm from "../../components/QuestionForm.astro";
import TopicGrid from "../../components/TopicGrid.astro";
import { articles, byLang, faqs } from "../../data/content";
import { searchGuides, guideText } from "../../data/searchGuides";
import { exercises } from "../../data/tools";
import { href } from "../../utils/paths";

const lang = "zh-cn";
const featuredFaqs = byLang(faqs, lang).slice(0, 5);
const featuredArticles = byLang(articles, lang).slice(0, 3);
const featuredGuides = searchGuides.slice(0, 3);
---

<BaseLayout
  lang={lang}
  title="超越者运动科学"
  description="用证据回答增肌、减脂、补剂、恢复与中老年训练问题。"
  path="/zh-cn/"
>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">健身问题，先问证据</p>
      <h1>把常见健身疑问，整理成能实际使用的科学答案。</h1>
      <p class="lede">
        从蛋白粉、肌酸、有氧、减脂到中老年重训，这里把热门问题和研究证据放在同一张地图上。
      </p>
      <div class="tag-row">
        <span class="tag">增肌</span>
        <span class="tag">减脂</span>
        <span class="tag">补剂避坑</span>
        <span class="tag">恢复</span>
      </div>
    </div>
    <aside class="hero-panel" aria-label="热门问题">
      <h2>热门问题</h2>
      <div class="question-strip">
        {featuredFaqs.map((faq) => <a href={href(`/zh-cn/faq/${faq.slug}/`)}><strong>{faq.title}</strong><span>{faq.description}</span></a>)}
      </div>
    </aside>
  </section>
  <section class="container section">
    <AdSlot variant="banner" label="Content ad" />
    <div class="section-head">
      <div>
        <h2>从目标开始找答案</h2>
        <p>不是每个人都需要同一套补剂、课表或饮食策略。先选情境，再看证据。</p>
      </div>
      <a class="pill-link" href={href("/zh-cn/topics/")}>全部主题</a>
    </div>
    <TopicGrid lang={lang} />
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>完整指南</h2>
        <p>把搜索者真正会问的问题整理成主题入口，再连到 FAQ、动作库、食物库和证据。</p>
      </div>
      <a class="pill-link" href={href("/zh-cn/guides/")}>全部指南</a>
    </div>
    <div class="grid">
      {featuredGuides.map((guide) => (
        <a class="card guide-link-card" href={href(`/zh-cn/guides/${guide.slug}/`)}>
          <div>
            <span class="meta">完整指南</span>
            <h3>{guideText(guide.title, lang)}</h3>
            <p>{guideText(guide.description, lang)}</p>
          </div>
          <span class="pill-link">阅读指南</span>
        </a>
      ))}
    </div>
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>直接查能用的工具</h2>
        <p>不只看 FAQ，也能从动作、肌群和食物份量开始做决策。</p>
      </div>
    </div>
    <div class="grid">
      <a class="card tool-card" href={href("/zh-cn/exercises/")}>
        <div><span class="meta">{exercises.length} 个动作</span><h3>动作库</h3><p>图片、主练肌群、器材、难度和推荐指数一次看。</p></div>
        <span class="pill-link">看动作</span>
      </a>
      <a class="card tool-card" href={href("/zh-cn/muscles/")}>
        <div><span class="meta">7 个肌群</span><h3>想练哪一块？</h3><p>胸、背、肩、腿、臀、腹、手臂，各自列出推荐动作排名。</p></div>
        <span class="pill-link">选肌群</span>
      </a>
      <a class="card tool-card" href={href("/zh-cn/foods/")}>
        <div><span class="meta">常见份量</span><h3>食物营养库</h3><p>鸡蛋用颗，其余用常见份量或 100 g 建立热量和营养直觉。</p></div>
        <span class="pill-link">查食物</span>
      </a>
    </div>
  </section>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>精选文章</h2>
        <p>从内部 wiki 精选并改写，适合做长文、短视频脚本和内容产品素材。</p>
      </div>
      <a class="pill-link" href={href("/zh-cn/articles/")}>全部文章</a>
    </div>
    <div class="grid">
      {featuredArticles.map((article) => (
        <a class="card" href={href(`/zh-cn/articles/${article.slug}/`)}>
          <div>
            <span class="meta">{article.readingTime}</span>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </div>
          <span class="pill-link">阅读</span>
        </a>
      ))}
    </div>
  </section>
  <div class="container">
    <QuestionForm lang={lang} />
  </div>
</BaseLayout>
