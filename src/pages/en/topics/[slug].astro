---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QuestionForm from "../../../components/QuestionForm.astro";
import TopicSeoGuide from "../../../components/TopicSeoGuide.astro";
import { articles, faqs, topics } from "../../../data/content";
import { topicGuideBySlug } from "../../../data/topicGuides";
import { href } from "../../../utils/paths";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const guide = topicGuideBySlug(topic.slug);
if (!guide) throw new Error("Topic guide not found");
const topicFaqs = faqs.filter((faq) => faq.lang === "en" && faq.topic === topic.slug);
const topicArticles = articles.filter((article) => article.lang === "en" && article.topic === topic.slug);
---

<BaseLayout lang="en" title={guide.enSeoTitle} description={guide.enDescription} path={`/en/topics/${topic.slug}/`} alternatePath={`/zh/topics/${topic.slug}/`}>
  <section class="container section">
    <p class="eyebrow">Complete guide</p>
    <h1>{guide.enH1}</h1>
    <p class="lede">{guide.enIntro}</p>
    <TopicSeoGuide guide={guide} lang="en" />
    <div class="section-head">
      <h2>FAQ</h2>
      <a class="pill-link" href={href("/en/faq/")}>All FAQ</a>
    </div>
    <div class="grid">
      {topicFaqs.slice(0, 6).map((faq) => (
        <a class="card" href={href(`/en/faq/${faq.slug}/`)}>
          <div><h3>{faq.title}</h3><p>{faq.description}</p></div>
          <span class="pill-link">Answer</span>
        </a>
      ))}
    </div>
    {
      topicArticles.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 34px;">
            <h2>Articles</h2>
            <a class="pill-link" href={href("/en/articles/")}>All articles</a>
          </div>
          <div class="grid">
            {topicArticles.slice(0, 6).map((article) => (
              <a class="card" href={href(`/en/articles/${article.slug}/`)}>
                <div><h3>{article.title}</h3><p>{article.description}</p></div>
                <span class="pill-link">Read</span>
              </a>
            ))}
          </div>
        </>
      )
    }
    <QuestionForm lang="en" />
  </section>
</BaseLayout>
