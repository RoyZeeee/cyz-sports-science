---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import { articles, faqs, topics } from "../../../data/content";
import { href } from "../../../utils/paths";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const topicFaqs = faqs.filter((faq) => faq.lang === "en" && faq.topic === topic.slug);
const topicArticles = articles.filter((article) => article.lang === "en" && article.topic === topic.slug);
---

<BaseLayout lang="en" title={topic.enTitle} description={topic.enDescription} path={`/en/topics/${topic.slug}/`} alternatePath={`/zh/topics/${topic.slug}/`}>
  <section class="container section">
    <p class="eyebrow">Topic</p>
    <h1>{topic.enTitle}</h1>
    <p class="lede">{topic.enDescription}</p>
    <div class="section-head">
      <h2>FAQ</h2>
      <a class="pill-link" href={href("/en/faq/")}>All FAQ</a>
    </div>
    <div class="grid">
      {topicFaqs.map((faq) => (
        <a class="card" href={href(`/en/faq/${faq.slug}/`)}>
          <div><h3>{faq.title}</h3><p>{faq.description}</p></div>
          <span class="pill-link">Answer</span>
        </a>
      ))}
    </div>
    <div class="section-head" style="margin-top: 34px;">
      <h2>Articles</h2>
      <a class="pill-link" href={href("/en/articles/")}>All articles</a>
    </div>
    <div class="grid">
      {topicArticles.map((article) => (
        <a class="card" href={href(`/en/articles/${article.slug}/`)}>
          <div><h3>{article.title}</h3><p>{article.description}</p></div>
          <span class="pill-link">Read</span>
        </a>
      ))}
    </div>
    <NewsletterSignup lang="en" />
  </section>
</BaseLayout>
